{
  "name": "iobroker.mopeka",
  "version": "0.0.4",
  "description": "Reads Mopeka BLE tank-level sensors (direct or via ble-gateway) into ioBroker",
  "author": {
    "name": "bluefox",
    "email": "dogafox@gmail.com"
  },
  "homepage": "https://github.com/ioBroker/ioBroker.mopeka",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "mopeka",
    "tank",
    "propane",
    "lpg",
    "ble",
    "bluetooth"
  ],
  "engines": {
    "node": ">=22"
  },
  "os1": [
    "linux",
    "darwin"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ioBroker/ioBroker.mopeka"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "@iobroker/dm-utils": "^3.2.1",
    "@stoprocent/noble": "^2.8.0"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/legacy-testing": "^4.0.1",
    "@iobroker/testing": "^6.3.2",
    "@types/node": "^22.20.5",
    "typescript": "~6.0.3"
  },
  "main": "build/main.js",
  "files": [
    "admin/",
    "build/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "test": "mocha --exit",
    "lint": "eslint -c eslint.config.mjs",
    "build": "tsc -p tsconfig.build.json",
    "build:webcomponents": "npm --prefix src-webcomponents ci && npm --prefix src-webcomponents run build",
    "update-packages": "npx -y npm-check-updates --upgrade && cd src-webcomponents && npx -y npm-check-updates --upgrade",
    "npm": "npm i && cd src-webcomponents && npm i",
    "release": "release-script",
    "test:package": "mocha test/package.test.js --exit",
    "test:integration": "mocha test/testAdapter.test.js --exit",
    "release-patch": "release-script patch --yes",
    "release-minor": "release-script minor --yes",
    "release-major": "release-script major --yes"
  },
  "bugs": {
    "url": "https://github.com/ioBroker/ioBroker.mopeka/issues"
  },
  "readmeFilename": "README.md"
}
